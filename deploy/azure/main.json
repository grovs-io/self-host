{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "1707266343421135683"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the VM, disk and network."
      }
    },
    "appDomain": {
      "type": "string",
      "minLength": 4,
      "metadata": {
        "description": "App base domain, for example grovs.example.com, without https:// or a path."
      }
    },
    "adminEmail": {
      "type": "string",
      "minLength": 5,
      "metadata": {
        "description": "Email address for the first Grovs administrator."
      }
    },
    "sshPublicKey": {
      "type": "string",
      "minLength": 40,
      "metadata": {
        "description": "Your SSH public key (the contents of your .pub file). Never enter a private key."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "grovsadmin",
      "metadata": {
        "description": "Linux administrator username, used only for SSH access."
      }
    },
    "sshSourceCidr": {
      "type": "string",
      "minLength": 9,
      "maxLength": 18,
      "metadata": {
        "description": "Your public IPv4 address with /32, for example 203.0.113.10/32. Only this source may SSH."
      }
    },
    "grovsVersion": {
      "type": "string",
      "defaultValue": "2.3.1",
      "metadata": {
        "description": "Published release shared by the backend and dashboard images."
      }
    },
    "stackRef": {
      "type": "string",
      "defaultValue": "d9f291fb7a943adc8b712696342180ea63438cfd",
      "metadata": {
        "description": "Reviewed self-host Git commit containing the Compose stack. Keep pinned for repeatable installs."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5",
      "allowedValues": [
        "Standard_D4s_v5",
        "Standard_D8s_v5",
        "Standard_D4s_v6",
        "Standard_D8s_v6"
      ],
      "metadata": {
        "description": "VM size; the default has 4 vCPUs and 16 GiB RAM. Availability depends on your region and quota."
      }
    },
    "diskSizeGb": {
      "type": "int",
      "defaultValue": 128,
      "minValue": 80,
      "maxValue": 1024,
      "metadata": {
        "description": "Persistent OS disk in GiB, including database and upload volumes. Detached when the VM alone is deleted."
      }
    }
  },
  "variables": {
    "$fxv#0": "#!/usr/bin/env bash\n# Run as root on a fresh Ubuntu 24.04 VM. Never prints generated credentials.\nset -euo pipefail\numask 077\n: \"${GROVS_DOMAIN:?Set the app domain}\"\n: \"${GROVS_ADMIN_EMAIL:?Set the admin email}\"\n: \"${GROVS_VERSION:?Set a published release version}\"\nSTACK_REF=\"${GROVS_STACK_REF:-main}\"\n[[ \"$GROVS_DOMAIN\" != local && \"$GROVS_DOMAIN\" != lvh.me ]] || {\n  echo \"Cloud deployments require a public domain.\" >&2; exit 1;\n}\n[[ $(id -u) == 0 ]] || { echo \"Run bootstrap.sh as root.\" >&2; exit 1; }\n# Provided by Ubuntu on the target VM; absent on macOS validation hosts.\n# shellcheck source=/dev/null\n. /etc/os-release\n[[ \"$ID\" == ubuntu && \"$VERSION_ID\" == 24.04 ]] || {\n  echo \"This bootstrap supports Ubuntu 24.04.\" >&2; exit 1;\n}\n\nexport DEBIAN_FRONTEND=noninteractive\napt-get update -qq\napt-get install -y ca-certificates curl git openssl docker.io docker-compose-v2\nsystemctl enable --now docker\n\n# Do not replace an existing checkout or regenerate an existing installation's secrets.\nif [[ ! -d /opt/grovs ]]; then\n  CHECKOUT=\"$(mktemp -d /opt/grovs-install.XXXXXX)\"\n  trap 'rm -rf \"$CHECKOUT\"' EXIT\n  git clone --quiet https://github.com/grovs-io/self-host.git \"$CHECKOUT\"\n  git -C \"$CHECKOUT\" checkout --quiet --detach \"$STACK_REF\"\n  mv \"$CHECKOUT\" /opt/grovs\n  trap - EXIT\nfi\ncd /opt/grovs\nchmod 700 /opt/grovs\nGROVS_CONFIG_DIR=/opt/grovs ./scripts/setup.sh > /opt/grovs/setup.log 2>&1\nchmod 600 .env setup.log\n\ncat > /etc/systemd/system/grovs.service <<'UNIT'\n[Unit]\nDescription=Grovs Community Docker Compose stack\nRequires=docker.service\nAfter=docker.service network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nWorkingDirectory=/opt/grovs\nExecStart=/usr/bin/docker compose --profile standalone up -d\nExecStop=/usr/bin/docker compose --profile standalone stop\nTimeoutStartSec=1200\nTimeoutStopSec=120\n\n[Install]\nWantedBy=multi-user.target\nUNIT\n\ndocker compose --profile standalone pull\nsystemctl daemon-reload\nsystemctl enable --now grovs\necho \"Grovs containers started. Configure DNS, then open https://dashboard.$GROVS_DOMAIN.\"\necho \"Administrator credentials are in /opt/grovs/.env (root access required).\"\n",
    "prefix": "[format('grovs-{0}', uniqueString(resourceGroup().id))]",
    "startupTemplate": "#!/usr/bin/env bash\nset -euo pipefail\nexport GROVS_DOMAIN=\"$(printf %s '__DOMAIN__' | base64 --decode)\"\nexport GROVS_ADMIN_EMAIL=\"$(printf %s '__EMAIL__' | base64 --decode)\"\nexport GROVS_VERSION=\"$(printf %s '__VERSION__' | base64 --decode)\"\nexport GROVS_STACK_REF=\"$(printf %s '__REF__' | base64 --decode)\"\n",
    "startupHeader": "[replace(replace(replace(replace(variables('startupTemplate'), '__DOMAIN__', base64(parameters('appDomain'))), '__EMAIL__', base64(parameters('adminEmail'))), '__VERSION__', base64(parameters('grovsVersion'))), '__REF__', base64(parameters('stackRef')))]",
    "startup": "[format('{0}\n{1}', variables('startupHeader'), variables('$fxv#0'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-nsg', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "http-https",
            "properties": {
              "priority": 100,
              "access": "Allow",
              "direction": "Inbound",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRanges": [
                "80",
                "443"
              ]
            }
          },
          {
            "name": "ssh-from-operator",
            "properties": {
              "priority": 110,
              "access": "Allow",
              "direction": "Inbound",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[parameters('sshSourceCidr')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-vnet', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.42.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "grovs",
            "properties": {
              "addressPrefix": "10.42.0.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', variables('prefix')))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-ip', variables('prefix'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-nic', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "primary",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[reference(resourceId('Microsoft.Network/virtualNetworks', format('{0}-vnet', variables('prefix'))), '2024-05-01').subnets[0].id]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-ip', variables('prefix')))]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', format('{0}-vnet', variables('prefix')))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', format('{0}-ip', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[variables('prefix')]",
      "location": "[parameters('location')]",
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "[format('{0}-data', variables('prefix'))]",
            "createOption": "FromImage",
            "deleteOption": "Detach",
            "diskSizeGB": "[parameters('diskSizeGb')]",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            }
          }
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        },
        "osProfile": {
          "computerName": "[variables('prefix')]",
          "adminUsername": "[parameters('adminUsername')]",
          "customData": "[base64(variables('startup'))]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "provisionVMAgent": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic', variables('prefix')))]",
              "properties": {
                "primary": true
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', format('{0}-nic', variables('prefix')))]"
      ]
    }
  ],
  "outputs": {
    "ipAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', format('{0}-ip', variables('prefix'))), '2024-05-01').ipAddress]"
    },
    "dashboard": {
      "type": "string",
      "value": "[format('https://dashboard.{0}', parameters('appDomain'))]"
    },
    "vmName": {
      "type": "string",
      "value": "[variables('prefix')]"
    },
    "sshCommand": {
      "type": "string",
      "value": "[format('ssh {0}@{1}', parameters('adminUsername'), reference(resourceId('Microsoft.Network/publicIPAddresses', format('{0}-ip', variables('prefix'))), '2024-05-01').ipAddress)]"
    }
  }
}