# Grovs self-hosted reverse proxy.
# Fixed hosts get Let's Encrypt certs at startup; per-project link subdomains
# (e.g. <project>.example.com) get certs issued on demand on first request.
# Caddy forwards X-Forwarded-For, so the backend's rate limiting sees real IPs.

{
	email {$ACME_EMAIL}
	on_demand_tls {
		# Permissive gate (any host that resolves here). For a hardened setup, use a
		# wildcard cert via your DNS provider's API instead (see README).
		ask http://backend-web-1:3000/up
	}
}

# Dashboard
{$DASHBOARD_HOST} {
	reverse_proxy dashboard:3000
}

# Backend reserved hosts (the app routes by subdomain).
{$API_HOST}, {$SDK_HOST}, {$MCP_HOST}, {$GO_HOST}, {$LINKS_PROD_HOST}, {$LINKS_TEST_HOST}, {$PREVIEW_HOST} {
	reverse_proxy backend-web-1:3000 backend-web-2:3000
}

# Per-project link subdomains (and any other host on the domain) — certs on demand.
https:// {
	tls {
		on_demand
	}
	reverse_proxy backend-web-1:3000 backend-web-2:3000
}
