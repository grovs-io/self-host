###############################################################################
# Grovs self-hosted — copy to .env and fill in. See README.md.
# Generate secrets with: ./scripts/setup.sh
###############################################################################

COMPOSE_PROJECT_NAME=grovs

# --- Public hostnames (point DNS A/AAAA records at this host) ------------------
# Production hosts live under DOMAIN_LIVE; the test link host lives under DOMAIN_TEST,
# which MUST be a separate registrable domain (see DOMAIN_LIVE/DOMAIN_TEST below).
DASHBOARD_HOST=dashboard.example.com
API_HOST=api.example.com
SDK_HOST=sdk.example.com
MCP_HOST=mcp.example.com
GO_HOST=go.example.com
LINKS_PROD_HOST=links.example.com
LINKS_TEST_HOST=links.example-test.com
PREVIEW_HOST=preview.example.com
# Email for Let's Encrypt (Caddy automatic TLS)
ACME_EMAIL=admin@example.com

# --- Self-hosted flags --------------------------------------------------------
GROVS_SELF_HOSTED=true
GROVS_EE=false

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=grovs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grovs_production
POSTGRES_MAX_CONNECTIONS=200
# The password here must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://grovs:change-me@postgres:5432/grovs_production

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Process sizing (tune to host capacity) -----------------------------------
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
RAILS_DB_POOL=10
SIDEKIQ_EVENTS_CONCURRENCY=10

# --- Object storage (bundled MinIO, S3-compatible) ----------------------------
MINIO_ROOT_USER=grovs
MINIO_ROOT_PASSWORD=change-me
AWS_S3_KEY_ID=grovs
AWS_S3_ACCESS_KEY=change-me
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=grovs
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# Blobs are served through the backend (proxy mode); point the prefix at the API host.
S3_ASSET_PREFIX=https://api.example.com

# --- Rails core ---------------------------------------------------------------
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=change-me
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me
ADMIN_API_KEY=change-me
DIAGNOSTICS_API_KEY=change-me
SENT_QUOTAS_WEBHOOK_KEY=change-me
PUBLIC_GO_PROJECT_IDENTIFIER=go-self-hosted
# Default app icon on link landing pages when a project has no app-store icon.
# Defaults to the Grovs logo; point it at your own logo (PNG/SVG URL) to rebrand.
DEFAULT_LOGO_URL=https://appssemble-assets.s3.eu-north-1.amazonaws.com/linksquared/logo-square-new.svg
# Default social/OG preview (image, title, subtitle) when a link has no custom preview.
DEFAULT_SOCIAL_PREVIEW_URL=https://appssemble-assets.s3.eu-north-1.amazonaws.com/linksquared/social-media-placeholder.jpg
DEFAULT_LINK_TITLE=grovs
DEFAULT_LINK_SUBTITLE="Dynamic links, attributions, and referrals across mobile and web platforms."

# --- Hosts the backend builds links/redirects against ------------------------
SERVER_HOST_PROTOCOL=https://
SERVER_HOST=api.example.com
REACT_HOST_PROTOCOL=https://
REACT_HOST=dashboard.example.com
# You need TWO separate registrable domains — one for production, one for test —
# exactly like the hosted service uses sqd.link (prod) + test-sqd.link (test).
# DOMAIN_LIVE: production BASE/registrable domain (e.g. example.com), NOT a subdomain —
# the reserved hosts above (api./sdk./go./mcp./preview.) are children of it.
DOMAIN_LIVE=example.com
# DOMAIN_TEST: a DISTINCT registrable domain (e.g. example-test.com). It must NOT be a
# sub-label of DOMAIN_LIVE — "test-links.example.com" WON'T route, because the host
# parser splits proj.test-links.example.com into subdomain "proj.test-links" + domain
# "example.com", so the test project never matches.
DOMAIN_TEST=example-test.com
PREVIEW_BASE_URL=https://preview.example.com
MCP_CONSENT_URL=https://dashboard.example.com/mcp/authorize

# --- OAuth (Doorkeeper "React" app) -------------------------------------------
# Generate once and keep both pairs identical. The seed upserts the React app to
# OAUTH_CLIENT_UID/SECRET; the dashboard is built with the matching NEXT_PUBLIC pair.
OAUTH_CLIENT_UID=generate-before-build
OAUTH_CLIENT_SECRET=generate-before-build
# These two MUST equal OAUTH_CLIENT_UID / OAUTH_CLIENT_SECRET above (do not use a
# ${...} reference — env_file passes values literally to the dashboard container).
NEXT_PUBLIC_CLIENT_ID=generate-before-build
CLIENT_SECRET=generate-before-build

# --- Dashboard (Next.js) ------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_PATH=/api/v1
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_SELF_HOSTED=true

# --- First-run admin (log in with no SMTP / SSO) ------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Email (optional; needed only for password reset + data exports) ----------
# Leave MAILER_DELIVERY_METHOD unset to disable email entirely.
MAILER_DELIVERY_METHOD=
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_FROM=Grovs <noreply@example.com>
