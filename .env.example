###############################################################################
# Grovs self-hosted. Copy to .env, or let ./scripts/setup.sh generate it.
###############################################################################

COMPOSE_PROJECT_NAME=grovs
# Release to run (ghcr.io/grovs-io/backend and ghcr.io/grovs-io/dashboard share it).
GROVS_VERSION=2.3.0

# --- Public hostnames (DNS A/AAAA records point at this host) -----------------
# App domain (dashboard, API, SDKs) and links domain may differ; scripts/setup.sh fills these.
DASHBOARD_HOST=dashboard.example.com
API_HOST=api.example.com
SDK_HOST=sdk.example.com
MCP_HOST=mcp.example.com
GO_HOST=go.example.com
LINKS_PROD_HOST=links.example.com
LINKS_TEST_HOST=links.test.example.com
PREVIEW_HOST=preview.example.com
# Let's Encrypt account email (Caddy automatic TLS)
ACME_EMAIL=admin@example.com

# --- Hosts the backend builds links and redirects against ---------------------
SERVER_HOST_PROTOCOL=https://
SERVER_HOST=example.com
REACT_HOST_PROTOCOL=https://
REACT_HOST=dashboard.example.com
# Links domain: production project links are <project>.<DOMAIN_LIVE> (e.g. acme.link).
DOMAIN_LIVE=example.com
# Test links domain: <project>.<DOMAIN_TEST>; test.<links domain> by default.
DOMAIN_TEST=test.example.com
PREVIEW_BASE_URL=https://preview.example.com
MCP_CONSENT_URL=https://dashboard.example.com/mcp/authorize
# Uploaded images are served through the API host.
S3_ASSET_PREFIX=https://api.example.com

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=grovs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grovs_production
POSTGRES_MAX_CONNECTIONS=200

# --- ClickHouse (analytics and event store) -----------------------------------
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_WRITE_ENABLED=true
CLICKHOUSE_READ_ENABLED=true
CLICKHOUSE_PRIMARY=true
CLICKHOUSE_ANALYTICS_ROLLUPS_READ_ENABLED=true
CLICKHOUSE_ATTRIBUTION_READ_ENABLED=true
CLICKHOUSE_LINK_DIMENSIONS_READ_ENABLED=true
REVENUE_READS_FROM_LEDGER=true
CLICKHOUSE_ROLLUP_FAST_LANE=true
DASHBOARD_CACHE_TTL_SECONDS=60
PG_SHADOW_WRITES=false

# --- Process sizing (tune to host capacity) -----------------------------------
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
RAILS_DB_POOL=10
SIDEKIQ_EVENTS_CONCURRENCY=10

# --- Uploads ------------------------------------------------------------------
# "local" keeps uploads in the storage volume. For S3 set "amazon" and the keys below.
ACTIVE_STORAGE_SERVICE=local
# AWS_S3_KEY_ID=
# AWS_S3_ACCESS_KEY=
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=grovs
# S3_ENDPOINT=            # only for S3-compatible stores (MinIO etc.)
# S3_FORCE_PATH_STYLE=true

# --- Secrets (generated by ./scripts/setup.sh) --------------------------------
SECRET_KEY_BASE=change-me
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me
ADMIN_API_KEY=change-me
DIAGNOSTICS_API_KEY=change-me
SENT_QUOTAS_WEBHOOK_KEY=change-me
PUBLIC_GO_PROJECT_IDENTIFIER=go-self-hosted

# --- Dashboard login (Doorkeeper app; the seed upserts it, the dashboard reads it) ----
OAUTH_CLIENT_UID=change-me
OAUTH_CLIENT_SECRET=change-me

# --- First-run admin (log in with no SMTP / SSO) ------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Branding defaults for link pages -----------------------------------------
DEFAULT_LOGO_URL=https://appssemble-assets.s3.eu-north-1.amazonaws.com/linksquared/logo-square-new.svg
DEFAULT_SOCIAL_PREVIEW_URL=https://appssemble-assets.s3.eu-north-1.amazonaws.com/linksquared/social-media-placeholder.jpg
DEFAULT_LINK_TITLE=grovs
DEFAULT_LINK_SUBTITLE="Dynamic links, attributions, and referrals across mobile and web platforms."

# --- Optional features (off by default; edit, then: docker compose up -d) ------
# Custom domains: customers CNAME their host to SELF_HOSTED_INGRESS_HOST and add it in the
# dashboard; the proxy issues its certificate on the first request.
# CUSTOM_DOMAINS_ENABLED=true
# CUSTOM_DOMAINS_PROVIDER=manual
# SELF_HOSTED_INGRESS_HOST=links.example.com   # what customers CNAME to; defaults to SERVER_HOST
# Migrate links from Branch / AppsFlyer (first click resolves upstream, then a native link).
# MIGRATIONS_ENABLED=true

# --- Email (optional; password reset, invites, data exports) ------------------
# Leave MAILER_DELIVERY_METHOD empty to disable email.
MAILER_DELIVERY_METHOD=
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_FROM=Grovs <noreply@example.com>
